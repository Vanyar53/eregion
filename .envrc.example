# Eregion — variables d'environnement
# Copier ce fichier en .envrc et remplir les valeurs
# cp .envrc.example .envrc

# ── LLM provider ──────────────────────────────────────────────────────────────
# Défaut : Anthropic Claude. Changer pour utiliser un autre provider.
#
# Anthropic (défaut)
export ANTHROPIC_API_KEY=sk-ant-...
# export GLORFINDEL_LLM_MODEL=anthropic/claude-sonnet-4-6
#
# OpenAI
# export GLORFINDEL_LLM_MODEL=openai/gpt-4o
# export OPENAI_API_KEY=sk-...
#
# Azure OpenAI
# export GLORFINDEL_LLM_MODEL=azure/gpt-4o
# export AZURE_API_KEY=...
# export AZURE_API_BASE=https://<resource>.openai.azure.com
# export AZURE_API_VERSION=2024-02-01
#
# Ollama (local / air-gap — gratuit, souverain)
#   Le modèle DOIT supporter le function/tool-calling (decide force un tool).
#   Validés en réel (make llm-smoke) : command-r7b et qwen2.5 (les + fiables),
#   mistral-nemo, llama3.1. ⚠ llama3.2-3b trop faible (mauvaises actions).
#   Setup : `ollama serve` + `ollama pull command-r7b`
# export GLORFINDEL_LLM_MODEL=ollama/command-r7b
# export GLORFINDEL_LLM_BASE_URL=http://localhost:11434
#   Vérifier qu'un modèle raisonne bien : make llm-smoke MODEL=ollama/<modèle> [--runs 5]
#
# Mistral AI (API cloud)
# export GLORFINDEL_LLM_MODEL=mistral/mistral-large-latest
# export MISTRAL_API_KEY=...
#
# Tout endpoint OpenAI-compatible (vLLM, LM Studio, Mistral self-hosted...)
# export GLORFINDEL_LLM_MODEL=openai/mistral-7b
# export GLORFINDEL_LLM_BASE_URL=http://my-server:8000

# ── Azure — un principal par service (V-17) ──────────────────────────────────
#
# Jamais Contributor sur l'abonnement. Deux rôles personnalisés (infra/identities/) et un
# principal par service, sur les groupes de ressources inscrits — les commandes complètes,
# la rotation des secrets et le retrait d'un ancien principal : docs/operations.md,
# « Identités Azure ».
#   watch    Reader + Log Analytics Reader + « Eregion Glorfindel Response »
#   console  Reader + Log Analytics Reader + Response + « Eregion Glorfindel Restore »
#   bot      Reader + Response + Restore
# Observe-only (évaluation) : un seul principal, Reader + Log Analytics Reader, et
# GLORFINDEL_READ_ONLY=1 — aucune écriture.
#
# az ad sp create-for-rbac --name "eregion-glorfindel-watch"     # sans rôle à la création
# az role assignment create --assignee <appId> --role Reader \
#   --scope /subscriptions/<SUBSCRIPTION_ID>/resourceGroups/<RG>
# Retourne : appId (CLIENT_ID), password (CLIENT_SECRET), tenant (TENANT_ID)
#
export GLORFINDEL_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
export GLORFINDEL_AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# export EREGION_CONSOLE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# export EREGION_CONSOLE_AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# export GLORFINDEL_BOT_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# export GLORFINDEL_BOT_AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Les écritures approuvées de la console et du bot sont celles de Glorfindel (AL1) : le compose
# ajoute leurs deux …_CLIENT_ID à GLORFINDEL_OWN_CALLERS pour la watch. Une watch lancée depuis
# le venv ne les connaît que par là — sinon chaque écriture approuvée devient une carte :
# export GLORFINDEL_OWN_CALLERS=$EREGION_CONSOLE_AZURE_CLIENT_ID,$GLORFINDEL_BOT_AZURE_CLIENT_ID
export AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# AZURE_CLIENT_* : ce que lit Glorfindel lancé depuis ce poste (le venv : glorfindel watch,
# glorfindel …) et le repli de tout service du compose dont la paire est vide. Le principal le
# moins large qui écrit : celui de la watch, jamais celui de la console (il restaure). Les
# injecteurs ne le prennent jamais (ANNATAR_AZURE_CLIENT_* seulement).
export AZURE_CLIENT_ID=$GLORFINDEL_AZURE_CLIENT_ID
export AZURE_CLIENT_SECRET=$GLORFINDEL_AZURE_CLIENT_SECRET
# Un restore depuis la CLI de ce poste, le chemin d'un humain comme la console : sa paire, pour
# cette commande seulement —
#   AZURE_CLIENT_ID=$EREGION_CONSOLE_AZURE_CLIENT_ID AZURE_CLIENT_SECRET=$EREGION_CONSOLE_AZURE_CLIENT_SECRET \
#     glorfindel restore <resource_id> --before <ISO8601> --yes
# Une paire va ensemble : un …_CLIENT_ID posé sans son …_SECRET mélange deux principaux (les
# replis se tirent variable par variable) — make glorfindel-start le dit (check-azure-env).

# az account show --query id -o tsv
export AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Annatar et Gothmog : sur ce poste, un injecteur reste passif (valider, lister, --dry-run) ; il
# agit depuis Orodruin, avec l'identité managée qu'y crée make orodruin-up (ses droits par VM
# inscrite). ANNATAR_AZURE_CLIENT_* seulement pour lire depuis ce poste (Reader sur le banc) ;
# vides, make annatar-* ne passe aucun principal (jamais AZURE_CLIENT_* en repli).
# export ANNATAR_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# export ANNATAR_AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Glorfindel — détection continue ──────────────────────────────────────────
# Plus de variable workspace_id / VM ici : le Log Analytics Workspace est défini
# dans glorfindel-config.yaml (section monitoring_backends), et les VMs sont
# découvertes automatiquement via le heartbeat LAW (discovery) — pas de resource_id
# statique à renseigner. detection_rules.yaml ne contient que les règles (queries,
# TTPs, noms de backends), aucun ID d'infra.

# ── Glorfindel — optionnel ────────────────────────────────────────────────────
# Slack / Teams / Discord webhook — actions autonomes (one-way)
# Slack/Teams :
# export GLORFINDEL_WEBHOOK_URL=https://hooks.slack.com/services/...
# Discord (ajouter /slack à la fin de l'URL webhook Discord) :
# export GLORFINDEL_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>/slack

# Discord Bot — escalades interactives (boutons, /pending)
# Créer sur https://discord.com/developers/applications → New Application → Bot
# Inviter avec scopes: bot + applications.commands, permissions: Send Messages + Read Messages
# DISCORD_CHANNEL_ID : clic droit sur le channel → Copy Channel ID (activer Developer Mode)
# export DISCORD_BOT_TOKEN=...
# export DISCORD_CHANNEL_ID=...
# export DISCORD_PING_ROLE=...    # ID du rôle à pinger à l'ouverture d'un fil (ex: @oncall)

# TTL isolation (défaut 4h) — mettre 0 pour désactiver
# export GLORFINDEL_ISOLATION_TTL_H=4

# Fenêtre incident multi-signal (défaut 300s)
# export GLORFINDEL_INCIDENT_TTL_S=300

# Mode forensique — ne pas libérer automatiquement
# export GLORFINDEL_KEEP_ISOLATED=1

# Mode observe-only — principal Reader + Log Analytics Reader — aucune action write exécutée
# Combine avec human_only (défaut) pour un déploiement zéro-risque en évaluation.
# Voir CLAUDE.md → "Mode observe-only" pour le workflow complet.
# export GLORFINDEL_READ_ONLY=1

# Gate de confiance — action autonome avec confidence < seuil → escaladée (défaut 0.7)
# Une valeur illisible ou hors de [0, 1] retient toute action autonome (échec fermé, G2).
# export GLORFINDEL_CONFIDENCE_THRESHOLD=0.7

# Borne d'un appel au modèle, par tentative (défaut 120 s) : un fournisseur pendu finit en
# carte cycle_failed au lieu de tenir la file de la VM (LiteLLM attendait 6000 s).
# export GLORFINDEL_LLM_TIMEOUT_S=120

# Accord des tirages (D-1) : une action disruptive (isolate_vm, block_suspicious_ip) prête à
# partir seule est redemandée au modèle, à son échantillonnage par défaut ; elle ne part
# que si tous les tirages la reprennent au-dessus du seuil, sinon carte unstable_decision.
# Défaut 3 ; un entier de 2 à 10 ; illisible, 1 ou plus de 10 → toute action disruptive
# autonome est retenue (échec fermé). Sans coût en human_only (rien ne part seul).
# export GLORFINDEL_DECISION_DRAWS=3

# Journal d'activité (AL1) : les écritures de Glorfindel lui-même (isolation, quarantaine,
# blocage) n'y sont pas escaladées — son identité, une opération qu'il fait, sur une cible
# qui est à lui (NSG de quarantaine, règles qu'un état d'isolation ou de blocage nomme — un
# nom glorfindel-* seul ne suffit pas). Son identité est lue dans son jeton et
# AZURE_CLIENT_ID ; en ajouter d'autres (objet ou application d'un principal de service),
# séparées par des virgules.
# Sous `az login` (jeton d'utilisateur), seul l'oid de l'utilisateur compte (l'appid est
# celui de la CLI, commun au tenant) : les écritures de cet utilisateur sur les règles de
# Glorfindel sont écartées comme les siennes — sur un hôte, une identité à lui.
# Option A (un seul SP pour Annatar et Glorfindel) : les écritures d'Annatar sur les
# ressources de Glorfindel (ses règles, ses NSG de quarantaine) seraient écartées comme
# les siennes — l'option B (SP séparés) les garde visibles.
# Journaux d'Entra ID (C2) : rien n'y est écarté sous ces identités, elles y sont marquées
# (acteur ou cible, critique) ; ajouter ici l'objet de l'application de Glorfindel pour
# qu'un identifiant ajouté à son inscription soit marqué.
# export GLORFINDEL_OWN_CALLERS=

# Rétention discovery — une VM éteinte (absente du Heartbeat) reste visible dans le
# registre tant que son dernier heartbeat date de moins de X heures, puis est évincée
# (défaut 8h). Évite qu'une VM juste éteinte disparaisse de la War Room.
# export GLORFINDEL_DISCOVERY_RETENTION_H=8

# ── Divers ────────────────────────────────────────────────────────────────────
# Supprime les logs ONNX Runtime (ChromaDB)
export ORT_LOGGING_LEVEL_DEFAULT=3
