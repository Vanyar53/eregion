# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets & config locaux
.env
.env.*
.envrc
*.tfvars
!*.tfvars.example
# SEC11 : la liste des VM dont H0 coupe les sessions, sans secret, gardée au dépôt ; SEC17 : celle
# des VM que le restore défend (les principaux qui restaurent, restore_principals, restent ignorés).
!infra/glorfindel-host/session_drain.auto.tfvars
!infra/glorfindel-host/restore.auto.tfvars
secrets.yaml
glorfindel-config.yaml

# Terraform
infra/terraform/.terraform/
# Le verrou des providers est suivi (CI4, #389) : .terraform.lock.hcl de chaque module.
infra/terraform/terraform.tfstate
infra/terraform/terraform.tfstate.backup
infra/terraform/*.tfplan

# Rapports de run (non versionnés)
runs/

# Coordination inter-sessions (éphémère, pas dans l'historique)
collab/

# VS Code
.vscode/settings.json

# OS
.DS_Store
Thumbs.db
*.code-workspace
infra/canary/**/.terraform/
infra/canary/**/.terraform.lock.hcl
infra/canary/**/terraform.tfstate*
.hypothesis-invariants/

# Claude Code — worktrees des sous-agents (elrond) et réglages locaux
.claude/worktrees/
.claude/settings.local.json

# Glorfindel hébergé (H0) — état séparé, secrets jamais suivis
infra/glorfindel-host/.terraform/
infra/glorfindel-host/terraform.tfstate*
infra/glorfindel-host/*.tfplan
infra/glorfindel-host/host.env

# Orodruin (O1) — état séparé, secrets jamais suivis
infra/orodruin/.terraform/
infra/orodruin/terraform.tfstate*
infra/orodruin/*.tfplan
infra/orodruin/orodruin.env

# pip-audit, son venv à part (make audit, CI2)
.venv-audit/

# SEC19 (R-13) : une clé privée ne se commite jamais (make harness-key la range hors du dépôt).
cosign.key
*.key
