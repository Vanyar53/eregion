# Glorfindel infrastructure configuration
# Copy to glorfindel-config.yaml and fill in your values.
# This file is mounted as a Docker volume — edit directly, no ${VAR} needed.
#
# Credentials (AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, ANTHROPIC_API_KEY...)
# stay in .envrc or environment variables — not here.

# ── Monitoring backends ────────────────────────────────────────────────────────
# Detection sources. Glorfindel will query these to detect attacks AND
# discover which assets are protected (via Heartbeat/equivalent).

monitoring_backends:
  - name: law-annatar
    type: azure_monitor
    # az monitor log-analytics workspace show -g <rg> -n <name> --query customerId -o tsv
    workspace_id: "YOUR_LAW_WORKSPACE_GUID"
    discovery:
      enabled: true
      interval_s: 1800    # rediscover every 30 min

  # Example: Prometheus backend (uncomment to enable)
  # - name: prometheus-local
  #   type: prometheus
  #   workspace_id: "http://localhost:9090"
  #   discovery:
  #     enabled: false    # Prometheus discovery not yet implemented

# ── Action backends ────────────────────────────────────────────────────────────
# Targets for remediation actions (restore, backup checks...).
# Not used for detection — no queries run against these.

action_backends:
  - name: rsv-annatar
    type: azure_backup_vault
    vault_name: "rsv-annatar"
    resource_group: "annatar"
    # Throwaway storage account where Azure temporarily writes the recovered disks
    # DURING a restore, before attaching them. This is NOT the vault's storage — the
    # backups live inside the vault. It's a scratch/staging area Azure requires to
    # restore from the immutable vault tier (the copy that survives ransomware).
    # → Any Standard LRS account in the VM's region/subscription works.
    # → Without it, `glorfindel restore` stops with a clear message (never a wrong name).
    # → Not needed for detection/isolation — only for restore_from_backup (T1486 recovery).
    restore_staging_storage: "stannatarexfil"

# ── Exceptions ────────────────────────────────────────────────────────────────
# Opt-out specific assets from auto-discovered monitoring.
# Uses fnmatch patterns (*, ?, [...] supported), case ignored as Azure ignores it.

exceptions: []

  # Example: exclude all dev VMs from all rules
  # - asset_pattern: "vm-dev-*"
  #   exclude_all: true

  # Example: exclude a specific VM from one rule only
  # - asset_pattern: "vm-staging"
  #   exclude_rules: [ssh-brute-force]

# ── Autonomy ────────────────────────────────────────────────────────────────────
# How much Glorfindel is allowed to ACT on its own, resolved per asset.
#
#   human_only     (default) — nothing executes. Every action, even reversible
#                  ones (isolate_vm/block/snapshot), is recommended and escalated.
#                  ⚠ Detection without response until a human acts — only use on
#                  critical assets if escalations are watched (webhook/bot/War Room).
#   non_disruptive — current behaviour: reversible actions run autonomously,
#                  destructive actions are always gated.
#   full_auto      — deferred; refused by config validation for now.
#
# Resolution order: matching asset rule > global default. Unknown assets fall
# back to the global default (never accidental escalation to a more permissive mode).
# A VM's name is matched case ignored (VM-PROD-DB names vm-prod-db): the exact
# entry first, then the longest pattern; tied entries that disagree give the most
# prudent mode.
# Start in human_only, observe what Glorfindel WOULD do on your real infra, then
# promote assets to non_disruptive once you trust it.
#
# Observe-only deployment: human_only only reads (detection/investigate/discovery).
# An orphan rule cutting a human_only VM off (A3) gets a card, never a removal.
# It runs on a Reader / Log Analytics Reader service principal — no Contributor
# needed. Set GLORFINDEL_READ_ONLY=1 to declare read-only creds: write actions
# then fail fast with a clear error instead of an opaque Azure 403.

autonomy:
  default: human_only
  # allow_destructive is a SEPARATE axis from the mode — delete/wipe are never
  # controlled by a mode. Empty = never autonomous, regardless of mode.
  allow_destructive: []
  assets: []
    # Example: dev VMs act autonomously, the prod DB stays human-gated
    # - match: "vm-dev-*"
    #   mode: non_disruptive
    # - match: "vm-prod-db"
    #   mode: human_only

# ── Never blocked ───────────────────────────────────────────────────────────────
# Addresses (or CIDR prefixes) Glorfindel never blocks, whatever the rule or the
# model says: a block of one is refused and escalated, never executed (SEC2).
# Already shipped, always: Azure's platform (168.63.129.16, 169.254.169.254), the
# private ranges (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7) and the loopback
# — a private address is never blocked: lateral movement is answered by isolating
# the source VM. Add your own:
# the office's egress, a scanner, a monitoring probe. /0 is refused.

never_block: []
  # - "198.51.100.10"        # the office's egress
  # - "203.0.113.0/28"       # the external scanner

# ── Expected sudo (ADM1) ────────────────────────────────────────────────────────
# The administrators whose sudo to root is expected, per VM or pattern of VMs
# (fnmatch, case ignored). Such a sudo opens no card: it is set aside before the
# decision, journaled (~/.glorfindel/expected_sudo.jsonl) and counted (glorfindel
# report, the console's rule) — unless its command is sensitive: the shipped list
# (/etc/shadow, useradd/usermod/passwd, sudoers, chmod u+s, setcap, stopping or
# removing a supervision agent, auditctl, logging config, deleting logs, cron,
# systemd units, kernel modules, the firewall, authorized_keys, PAM, LD_PRELOAD,
# and root shells: sudo -i/-s, su, bash, python -c, find -exec, vim, less, screen…),
# extended — never replaced — by sensitive_commands (texts found in the command
# line, case ignored). Root shells make a card in their known forms; the list is
# not exhaustive (a script not listed, `sudo /tmp/x.py`, passes) until AUD1
# (auditd); COR1 sets aside a root shell by its SSH session's origin (below). Edit files with sudoedit. An account is
# written in full, no pattern. Another account, `sudo -u other`, a line no VM
# claims: always a card. Real account names belong in your local config only,
# never in a repository.

#
# origins (COR1): where an entry's SSH sessions come from (CIDR ranges; a bastion is
# a range). A root shell is set aside only if every session of the account, over 7
# days, comes from one of them — read in the VM's Syslog only, a noise reducer.
# origin_proof (COR2): a source outside the VM that must also show each of those
# sessions — `bastion` (Azure Bastion's audit logs in the workspace) or `flows` (the
# VNet's flow logs, traffic analytics); `none` (the default) keeps COR1. A trace
# absent or unreadable: a card. Read docs/operations.md (« Déclarer la source qui
# confirme l'origine sur H0 (COR2) ») before setting it.

expected_sudo:
  # origin_proof: bastion
  admins: []
    # - match: "vm-web-*"
    #   accounts: [admin1, ops]
    #   origins: [198.51.100.0/26]   # the AzureBastionSubnet, the VPN's exit
  sensitive_commands: []
    # - "/usr/local/bin/backup-restore"

# ── The memory of past cycles (SEC17, V-12) ─────────────────────────────────
# A past cycle stored more than max_age_days ago is no precedent: left out of the
# search, never erased (`glorfindel report` says how many). A finite number of days,
# positive, at most 3650 — 90 by default.

memory:
  max_age_days: 90
