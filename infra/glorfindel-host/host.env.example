# host.env — l'environnement de Glorfindel sur sa VM (H0). Copier en host.env (ignoré par git),
# remplir, puis `make glorfindel-host-push`. Il devient ~/eregion/.env sur la VM (chmod 600),
# que docker compose lit. Jamais dans l'état Terraform.

AZURE_SUBSCRIPTION_ID=
AZURE_WORKSPACE_ID=            # terraform output workspace_id
# Pas d'AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID : l'identité managée de la VM.

ANTHROPIC_API_KEY=
GLORFINDEL_LLM_MODEL=anthropic/claude-sonnet-4-6

# Pré-observation : aucune écriture vers Azure (une tentative lève une erreur claire).
GLORFINDEL_READ_ONLY=1

# La War Room passe par un tunnel SSH ; le jeton protège quand même toutes ses routes.
GLORFINDEL_WARROOM_TOKEN=

# Alertes (sortantes) : le bot Discord, ou un webhook.
DISCORD_BOT_TOKEN=             # le bot tourne sur la VM (profil compose `bot`) : aucun autre bot avec ce jeton
DISCORD_CHANNEL_ID=
DISCORD_PING_ROLE=
GLORFINDEL_WEBHOOK_URL=
