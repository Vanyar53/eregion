# host.env — l'environnement de Glorfindel sur sa VM (H0). Copier en host.env (ignoré par git),
# remplir, puis `make glorfindel-host-push`. Il devient ~/eregion/.env sur la VM (chmod 600),
# que docker compose lit. Jamais dans l'état Terraform.
#
# Un seul fichier, mais pas un seul environnement (M-3) : compose s'en sert pour remplir
# docker-compose.yml, et chaque conteneur ne reçoit que les variables de sa liste. Entre
# crochets, qui la reçoit : [watch], [console] (le service compose `war-room`), [bot], [tous].
#
# Chaque commentaire est AU-DESSUS de sa ligne, jamais à côté : pour docker compose,
# `KEY=   # note` vaut « # note », pas une valeur vide (mesuré avec `docker compose config`) ;
# une variable laissée vide doit rester vide. tests/unit/test_host_console.py le vérifie.

# [tous]
AZURE_SUBSCRIPTION_ID=
# [tous] terraform output workspace_id
AZURE_WORKSPACE_ID=
# Pas d'AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID : l'identité managée de la VM.

# [watch] seule
ANTHROPIC_API_KEY=
# [tous] (la console l'affiche)
GLORFINDEL_LLM_MODEL=anthropic/claude-sonnet-4-6
# [tous] L'IA d'analyse (IA1) : la watch écrit les rapports de campagne avec ce modèle, jamais
# celui de Glorfindel — le même est refusé, et chaque rapport abandonné après 3 essais.
# Vide : anthropic/claude-haiku-5-5. À changer si GLORFINDEL_LLM_MODEL le prend.
EREGION_ANALYSIS_MODEL=

# Les fenêtres d'exercice d'Orodruin (O1) : `terraform -chdir=infra/orodruin output -raw channel_url`.
# Vide : les cycles des exercices lancés depuis Orodruin restent « real ». [tous]
EREGION_EXERCISE_CHANNEL=

# Le canal retour (#159) : `terraform -chdir=infra/orodruin output -raw watch_channel_url`.
# La watch y publie son battement de cœur et ses détections des VM d'une fenêtre ouverte ou en
# grâce ; un run lancé depuis Orodruin y lit sa détection. Le stockage d'Eregion, pas l'infra
# observée : GLORFINDEL_READ_ONLY ne le bloque pas. Vide : le run écrit `detection: unknown`. [tous]
EREGION_WATCH_CHANNEL=

# Pré-observation : aucune écriture vers Azure (une tentative lève une erreur claire). [tous]
GLORFINDEL_READ_ONLY=1

# La console d'Eregion (`eregion console`) passe par un tunnel SSH ; le jeton protège quand même
# toutes ses routes. [console] seule. Le tirer : python -c 'import secrets; print(secrets.token_urlsafe(24))'
# Un host.env qui n'a que son ancien nom, GLORFINDEL_WARROOM_TOKEN (H0), reste valide : rien à
# renommer (la console prend EREGION_CONSOLE_TOKEN s'il n'est pas vide, sinon l'ancien).
# Ce nom n'est lu que par une référence avec UI-1 : une plus ancienne (v0.3.0) ne lit que l'ancien.
EREGION_CONSOLE_TOKEN=

# Alertes (sortantes) : le bot Discord, ou un webhook.
# [bot] seul ; le bot tourne sur la VM (profil compose `bot`) : aucun autre bot avec ce jeton.
# La watch et la console reçoivent GLORFINDEL_DISCORD_BOT=1 (posé) ou vide, jamais la valeur.
DISCORD_BOT_TOKEN=
# [tous] ; avec le jeton, la watch et la console laissent les cartes au bot (webhook muet) ;
# sans jeton, le webhook poste.
DISCORD_CHANNEL_ID=
# [bot]
DISCORD_PING_ROLE=
# Qui peut cliquer les boutons des cartes (M-3) : ids Discord séparés par des virgules
# (mode développeur, clic droit sur ton nom ou sur un rôle, « Copier l'identifiant »).
# Vides : tous les boutons refusent (fermé par défaut) ; la console juge toujours. [bot]
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_ROLES=
# [watch] [console] ; l'URL porte un jeton.
GLORFINDEL_WEBHOOK_URL=
