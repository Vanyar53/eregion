# host.env — l'environnement de Glorfindel sur sa VM (H0). Copier en host.env (ignoré par git),
# remplir, puis `make glorfindel-host-push`. Il devient ~/eregion/.env sur la VM (chmod 600),
# que docker compose lit. Jamais dans l'état Terraform.
#
# Un seul fichier, mais pas un seul environnement (M-3) : compose s'en sert pour remplir
# docker-compose.yml, et chaque conteneur ne reçoit que les variables de sa liste. Entre
# crochets, qui la reçoit : [watch], [war-room], [bot], [tous].

AZURE_SUBSCRIPTION_ID=         # [tous]
AZURE_WORKSPACE_ID=            # [tous] terraform output workspace_id
# Pas d'AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID : l'identité managée de la VM.

ANTHROPIC_API_KEY=             # [watch] seule
GLORFINDEL_LLM_MODEL=anthropic/claude-sonnet-4-6   # [tous] (la War Room l'affiche)

# Les fenêtres d'exercice d'Orodruin (O1) : `terraform -chdir=infra/orodruin output -raw channel_url`.
# Vide : les cycles des exercices lancés depuis Orodruin restent « real ». [tous]
EREGION_EXERCISE_CHANNEL=

# Le canal retour (#159) : `terraform -chdir=infra/orodruin output -raw watch_channel_url`.
# La watch y publie son battement de cœur et ses détections des VM d'une fenêtre ouverte ou en
# grâce ; un run lancé depuis Orodruin y lit sa détection. Le stockage d'Eregion, pas l'infra
# observée : GLORFINDEL_READ_ONLY ne le bloque pas. Vide : le run écrit `detection: unknown`. [tous]
EREGION_WATCH_CHANNEL=

# Pré-observation : aucune écriture vers Azure (une tentative lève une erreur claire). [tous]
GLORFINDEL_READ_ONLY=1

# La War Room passe par un tunnel SSH ; le jeton protège quand même toutes ses routes. [war-room] seule
GLORFINDEL_WARROOM_TOKEN=

# Alertes (sortantes) : le bot Discord, ou un webhook.
DISCORD_BOT_TOKEN=             # [bot] seul ; le bot tourne sur la VM (profil compose `bot`) : aucun autre bot avec ce jeton.
                               # La watch et la War Room reçoivent GLORFINDEL_DISCORD_BOT=1 (posé) ou vide, jamais la valeur
DISCORD_CHANNEL_ID=            # [tous] ; avec le jeton, la watch et la War Room laissent les cartes au bot (webhook muet) ; sans jeton, le webhook poste
DISCORD_PING_ROLE=             # [bot]
# Qui peut cliquer les boutons des cartes (M-3) : ids Discord séparés par des virgules
# (mode développeur, clic droit sur ton nom ou sur un rôle, « Copier l'identifiant »).
# Vides : tous les boutons refusent (fermé par défaut) ; la War Room juge toujours.
DISCORD_ALLOWED_USERS=         # [bot]
DISCORD_ALLOWED_ROLES=         # [bot]
GLORFINDEL_WEBHOOK_URL=        # [watch] [war-room] ; l'URL porte un jeton
