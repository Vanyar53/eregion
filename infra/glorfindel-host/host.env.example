# host.env — l'environnement de Glorfindel sur sa VM (H0). Copier en host.env (ignoré par git),
# remplir, puis `make glorfindel-host-push`. Il devient ~/eregion/.env sur la VM (chmod 600),
# que docker compose lit. Jamais dans l'état Terraform.
#
# Un seul fichier, mais pas un seul environnement (M-3) : compose s'en sert pour remplir
# docker-compose.yml, et chaque conteneur ne reçoit que les variables de sa liste. Entre
# crochets, qui la reçoit : [watch], [console] (le service compose `war-room`), [bot], [tous].
#
# Chaque commentaire est AU-DESSUS de sa ligne, jamais à côté : pour docker compose,
# `KEY=   # note` vaut « # note », pas une valeur vide (mesuré avec `docker compose config`) ;
# une variable laissée vide doit rester vide. tests/unit/test_host_console.py le vérifie.

# [tous]
AZURE_SUBSCRIPTION_ID=
# [tous] terraform output workspace_id
AZURE_WORKSPACE_ID=
# Pas d'AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID : l'identité managée de la VM.

# La clé que lit le fournisseur de GLORFINDEL_LLM_MODEL, et elle seule (OL1) : anthropic/… ou
# vide, ANTHROPIC_API_KEY ; openai/…, OPENAI_API_KEY ; azure/…, AZURE_API_KEY et AZURE_API_BASE
# (ou GLORFINDEL_LLM_BASE_URL à sa place) ; mistral/…, MISTRAL_API_KEY ; ollama/…, aucune clé
# mais GLORFINDEL_LLM_BASE_URL ; un modèle auto-hébergé compatible OpenAI (openai/… servi par
# GLORFINDEL_LLM_BASE_URL), rien. Plus celle du fournisseur d'EREGION_ANALYSIS_MODEL (vide :
# ANTHROPIC_API_KEY). Les autres restent vides. Un autre fournisseur est refusé. [watch] seule.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=
# [tous] (la console l'affiche)
GLORFINDEL_LLM_MODEL=anthropic/claude-sonnet-5-5
# [tous] Ollama ou un modèle auto-hébergé : son adresse vue du conteneur de la watch — jamais
# localhost, qui y est le conteneur lui-même (ex. http://<hôte d'Ollama>:11434).
GLORFINDEL_LLM_BASE_URL=
# [tous] L'IA d'analyse (IA1) : la watch écrit les rapports de campagne avec ce modèle, jamais
# celui de Glorfindel — le même est refusé, et chaque rapport abandonné après 3 essais.
# Vide : anthropic/claude-haiku-5-5. À changer si GLORFINDEL_LLM_MODEL le prend. Jamais un
# modèle local (ollama/…) : l'analyse ne lit pas encore GLORFINDEL_LLM_BASE_URL (OL1).
EREGION_ANALYSIS_MODEL=

# Les fenêtres d'exercice d'Orodruin (O1) : `terraform -chdir=infra/orodruin output -raw channel_url`.
# Vide : les cycles des exercices lancés depuis Orodruin restent « real ». [tous]
EREGION_EXERCISE_CHANNEL=

# Le canal retour (#159) : `terraform -chdir=infra/orodruin output -raw watch_channel_url`.
# La watch y publie son battement de cœur et ses détections des VM d'une fenêtre ouverte ou en
# grâce ; un run lancé depuis Orodruin y lit sa détection. Le stockage d'Eregion, pas l'infra
# observée : GLORFINDEL_READ_ONLY ne le bloque pas. Vide : le run écrit `detection: unknown`. [tous]
EREGION_WATCH_CHANNEL=

# NT1 (#583) : qui n'est jamais une cible (eregion_core/never_target.py). La watch lit la liste pour
# écrire le plan d'une carte d'identité (IR1a) : des ids, aucun secret. Vide ou mal écrite, la liste
# est illisible et chaque verbe d'un plan devient une étape de l'humain — `--check` le dit, sans
# refuser le push. [watch] seule.
# L'opérateur : `terraform -chdir=infra/orodruin output -raw operator_object_id`.
EREGION_OPERATOR_OBJECT_ID=
# Orodruin et les watches : `terraform -chdir=infra/orodruin output -raw protected_identities`, et
# l'object id de l'exécuteur d'identité une fois activé
# (`terraform -chdir=infra/glorfindel-host output -raw identity_executor_object_id`), séparés par
# des virgules.
EREGION_PROTECTED_IDENTITIES=
# L'exécuteur d'identité (IR1b) : `terraform -chdir=infra/glorfindel-host output -raw
# identity_executor_client_id` — vide tant qu'il n'est pas activé.
EREGION_IDENTITY_EXECUTOR_CLIENT_ID=

# Pré-observation : aucune écriture vers Azure (une tentative lève une erreur claire). [tous]
GLORFINDEL_READ_ONLY=1

# La console d'Eregion (`eregion console`) passe par un tunnel SSH ; le jeton protège quand même
# toutes ses routes. [console] seule. Le tirer : python -c 'import secrets; print(secrets.token_urlsafe(24))'
# Un host.env qui n'a que son ancien nom, GLORFINDEL_WARROOM_TOKEN (H0), reste valide : rien à
# renommer (la console prend EREGION_CONSOLE_TOKEN s'il n'est pas vide, sinon l'ancien).
# Ce nom n'est lu que par une référence avec UI-1 : une plus ancienne (v0.3.0) ne lit que l'ancien.
EREGION_CONSOLE_TOKEN=

# Alertes (sortantes) : le bot Discord, ou un webhook.
# [bot] seul ; le bot tourne sur la VM (profil compose `bot`) : aucun autre bot avec ce jeton.
# La watch et la console reçoivent GLORFINDEL_DISCORD_BOT=1 (posé) ou vide, jamais la valeur.
DISCORD_BOT_TOKEN=
# [tous] ; avec le jeton, la watch et la console laissent les cartes au bot (webhook muet) ;
# sans jeton, le webhook poste.
DISCORD_CHANNEL_ID=
# [bot]
DISCORD_PING_ROLE=
# Qui peut cliquer les boutons des cartes (M-3) : ids Discord séparés par des virgules
# (mode développeur, clic droit sur ton nom ou sur un rôle, « Copier l'identifiant »).
# Vides : tous les boutons refusent (fermé par défaut) ; la console juge toujours. [bot]
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_ROLES=
# [watch] [console] ; l'URL porte un jeton.
GLORFINDEL_WEBHOOK_URL=

# SEC19 (N-03) : la clé publique de la watch de H0 (make glorfindel-host-watch-key), pour que la
# console montre la garde des injecteurs comme Orodruin la lit (Dagorlad). [console]
EREGION_WATCH_KEY=

# FS1b (#563) : la file d'actions signée. « 1 » : la console et le bot déposent leurs gestes signés,
# la watch les juge — vide (le défaut) : rien ne change, l'appel direct reste. Ne la poser qu'avec
# FS1c, mesurée au banc (docs/design/file-actions-signee.md). [watch] [console] [bot]
EREGION_ACTION_QUEUE=
# Les clés publiques de la console et du bot, épinglées chez la watch : la ligne que
# `make glorfindel-host-queue-keys` imprime, une fois les deux services démarrés avec la file. [watch]
EREGION_QUEUE_KEYS=

# SEC19 (R-13) : la clé publique qui signe l'attestation du harnais — la ligne EREGION_HARNESS_KEY=…
# que `make harness-key` imprime (le DER de cosign.pub en base64, sur une ligne). Lue par le CD de
# H0 seul (~/eregion/.env) : aucun conteneur ne la reçoit, le dépôt ne la porte jamais. Vide : le CD
# ne croit aucune attestation, et refuse tout nouveau verrou en le disant.
EREGION_HARNESS_KEY=
