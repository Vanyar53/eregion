# SEC17 : les principaux du poste, par leur object id (jamais l'appId) — à copier en
# principals.auto.tfvars (ignoré par git), sur le poste de l'opérateur seulement :
#   az ad sp show --id <appId-console> --query id -o tsv
#   az ad sp show --id <appId-bot> --query id -o tsv
# Jamais l'identité de H0 (le plan la refuse) : Glorfindel hébergé ne restaure pas, et il a déjà la
# coupure des sessions.
#
# Qui restaure : la neutralisation avant un restore sur chaque VM de restore_vms.
restore_principals = {
  console = "00000000-0000-0000-0000-000000000000"
  bot     = "00000000-0000-0000-0000-000000000000"
}
# Qui isole lui-même ce qu'un humain approuve : la coupure des sessions sur chaque VM de
# session_drain_vms. La console seulement : le bot n'isole pas.
session_drain_principals = {
  console = "00000000-0000-0000-0000-000000000000"
}
