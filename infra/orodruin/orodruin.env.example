# Copier en orodruin.env (jamais suivi par git) ; `make orodruin-push` le pose sur la VM.
# Pas de AZURE_CLIENT_ID / AZURE_CLIENT_SECRET : l'identité managée de la VM suffit, et des
# variables vides la masqueraient.
AZURE_SUBSCRIPTION_ID=
EREGION_BENCH_RG=rg-celebrimbor
# Le plafond déclaré, relu par le contrat (plafonds : 20 injections, 7200 s).
EREGION_MAX_INJECTIONS=10
EREGION_MAX_RUN_S=3600
# Le canal des fenêtres d'exercice vers le Glorfindel hébergé (terraform output) :
# channel_url → EREGION_EXERCISE_CHANNEL ; channel_scope → EREGION_CHANNEL_SCOPE (le contrat
# accepte cette seule attribution hors du banc).
EREGION_EXERCISE_CHANNEL=
EREGION_CHANNEL_SCOPE=
# Le canal retour (#159) : battement de cœur et détections de la watch hébergée.
# watch_channel_url → EREGION_WATCH_CHANNEL ; watch_channel_scope → EREGION_WATCH_CHANNEL_SCOPE
# (le contrat n'y accepte qu'un rôle de lecture). Vide → le run ne voit que la watch locale.
EREGION_WATCH_CHANNEL=
EREGION_WATCH_CHANNEL_SCOPE=
# Le planner d'Annatar (campaign plan --llm), si utilisé depuis Orodruin.
ANTHROPIC_API_KEY=
# SEC19 (N-03) : la clé publique de la watch hébergée (H0), épinglée ici — le battement du canal
# retour n'est cru que signé par elle. `make glorfindel-host-watch-key` la donne. Vide : refusé.
# Sans H0 (WC1), celle de la watch du poste qui écrit le canal : `make watch-key` sur ce poste.
EREGION_WATCH_KEY=
# IDI1 (#546) : la garde d'une identité d'Entra ID (terraform output de infra/orodruin) —
# tenant_id → EREGION_TENANT_ID ; operator_object_id → EREGION_OPERATOR_OBJECT_ID (sans lui, toute
# identité est refusée) ; protected_identities → EREGION_PROTECTED_IDENTITIES. Jamais des cibles :
# l'opérateur, Orodruin, les watches.
EREGION_TENANT_ID=
EREGION_OPERATOR_OBJECT_ID=
EREGION_PROTECTED_IDENTITIES=
