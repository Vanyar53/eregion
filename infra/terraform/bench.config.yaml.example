# ── Eregion test bench — config de déploiement à la demande ──────────────────
# Même esprit que config.yaml (yamldecode, for_each). Copie en `bench.config.yaml`
# et active ce que tu veux. TOUT à false par défaut → un apply de base ne déploie
# RIEN de coûteux. Le bench est JETABLE (pas 24/7) — détruis-le après les tests.
#
#   make bench-up                      # applique bench.config.yaml
#   make bench-up TOPO="multinic,aks"  # n'active que ces topos (surcharge)
#   make bench-down                    # détruit le bench
#   make bench-stop / bench-start      # éteint/rallume les VMs sans détruire
#
# Le module infra/terraform/bench/ (à construire par la session infra) lit ce
# fichier. Ce fichier EST le contrat de config attendu.

# ── Global ───────────────────────────────────────────────────────────────────
location:          westeurope
bench_rg_prefix:   eregion-bench      # 1 RG par topo : <prefix>-multinic, -aks, ...
vm_size:           Standard_B2s       # taille éco par défaut
auto_shutdown_utc: "2300"             # arrêt auto nocturne des VMs (coût)
tags:
  project: eregion
  bench:   "true"
  ttl:     destroy-after-test         # rappel : jetable, pas 24/7

# ── Topologies (toutes enabled:false par défaut) ─────────────────────────────
topologies:

  # 1. VM 2 NICs, 1 NSG par NIC (niveau NIC) → isolation multi-NIC (7603a3e)
  multinic:
    enabled: false

  # 2. VM derrière un NSG de SUBNET (+ une VM voisine) → deny scopé IP, non-impact
  subnet_nsg:
    enabled: false

  # 3. VM 2 NICs — mix NSG NIC + NSG subnet → 2 scopes en une passe
  mix_nsg:
    enabled: false

  # 4. NIC à plusieurs ipConfigs → couverture de toutes les IP (règle augmentée)
  multiip:
    enabled: false
    secondary_ips: 1                  # nb d'ipConfigs supplémentaires sur la NIC

  # 5. Cluster AKS → groupage kind/parent (cb3593b) + posture skip (9a7bd59)
  aks:
    enabled: false
    node_count: 2

  # 6. Vault cross-RG (RSV dans son propre RG) → check_backup_points RG du vault (4ba8134)
  vault_cross_rg:
    enabled: false

  # 7. Deux Log Analytics Workspaces → binding règle↔backend multi-LAW (90a0b09)
  two_law:
    enabled: false

  # 8. Deux Recovery Services Vaults → résolution multi-vault (4ba8134/754aea0)
  #    ⚠ révèle probablement le gap backup_vault()="premier vault" → mapping asset→vault
  two_rsv:
    enabled: false
