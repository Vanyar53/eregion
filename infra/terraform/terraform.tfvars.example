admin_ssh_public_key = "ssh-ed25519 AAAA... your-key-comment"
# Optionnel : prévenu 15 min avant l'extinction automatique des VMs (vide → pas d'e-mail).
vm_shutdown_email    = "you@example.com"

# Optionnel — sinon le provider lit ARM_SUBSCRIPTION_ID de l'env (le Makefile le
# dérive de AZURE_SUBSCRIPTION_ID). Décommenter pour figer l'abonnement ici.
# subscription_id = "00000000-0000-0000-0000-000000000000"

# Optionnel (ID1) — les journaux du plan de contrôle et d'Entra ID vers le workspace du banc.
# Désactivés par défaut ; à poser ici (persistant), jamais en -var d'une seule commande.
# Puis : make celebrimbor-logs-plan, et make celebrimbor-logs-up YES=1 (docs/operations.md).
# activity_log_enabled = true   # paramètre de l'ABONNEMENT (Monitoring Contributor)
# entra_logs_enabled   = true   # paramètre du TENANT (Administrateur de la sécurité d'Entra)

# Optionnel (AUD1) — auditd sur les VM du banc, ses lignes vers le workspace (local6 → Syslog).
# Désactivé par défaut ; à poser ici, jamais en -var. Puis : make celebrimbor-auditd-plan, et
# make celebrimbor-auditd-up YES=1 (docs/operations.md, « auditd au banc (AUD1) »).
# auditd_enabled = true

# Optionnel (VM3, #548) — la facilité cron dans la DCR, pour la détection de persistance cron
# (T1053.003). Désactivé par défaut ; à poser ici, jamais en -var (monitoring.tf).
# cron_logs_enabled = true

# Optionnel (IDI1) — une identité de test du banc dans Entra ID (une application et son principal,
# mono-tenant, sans secret), inscrite par les deux clés. Désactivée par défaut ; à poser ici, jamais
# en -var. Puis : make celebrimbor-identity-plan, et make celebrimbor-identity-up YES=1
# (docs/operations.md, « L'identité de test du banc (IDI1) »).
# entra_test_identity_enabled = true

# Optionnel (IDI1b) — l'unité administrative restreinte du banc et ses utilisateurs de test, inscrits
# par l'unité et l'attribut Eregion. Désactivé par défaut ; à poser ici, jamais en -var. D'abord
# make celebrimbor-unit-prepare YES=1 (l'unité, créée par Graph : son id à épingler), puis
# make celebrimbor-users-plan, et make celebrimbor-users-up YES=1 (docs/operations.md,
# « Les utilisateurs de test du banc (IDI1b) »).
# entra_bench_unit_enabled = true
# entra_bench_unit_id      = "<l'id que celebrimbor-unit-prepare a dit>"
# entra_test_users         = ["tuor"]
# entra_identity_executor_object_id = "<le principal de l'exécuteur d'IR1, quand IR1b l'a créé>"

# Optionnel (BRO1) — l'identité de lecture du banc, pour la session Banc seule : une application,
# son principal, un certificat public tiré sur ce poste (la clé privée n'entre jamais dans l'état),
# Log Analytics Reader sur le seul workspace du banc. Désactivée par défaut ; à poser ici, jamais en
# -var. D'abord make celebrimbor-reader-key, puis make celebrimbor-reader-plan, make
# celebrimbor-reader-up YES=1 et make celebrimbor-reader-profile (docs/operations.md,
# « L'identité de lecture du banc (BRO1) »).
# bench_reader_enabled = true
# bench_reader_certificate_file = "~/.config/eregion-banc/reader.crt"   # le défaut
# bench_reader_certificate_end_file = "~/.config/eregion-banc/reader.end"   # le défaut : la fin du certificat, que keygen écrit
