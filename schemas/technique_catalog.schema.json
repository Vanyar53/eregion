{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Vanyar53/eregion/schemas/technique_catalog.schema.v1.json",
  "title": "Eregion Technique & Fault Catalog v1",
  "description": "The shared Annatar↔Glorfindel contract (technique_catalog.yaml). Per resource type: `techniques` (MITRE ATT&CK, read by Annatar's planner and Glorfindel's rule authoring) and, since E1, `faults` (declared failures for Gothmog, with their own id — a fault has no ATT&CK id). Faults sit in their own list so that neither technique loader picks them up.",
  "type": "object",
  "required": [
    "version",
    "resource_types"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "resource_types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "techniques": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/entry"
            }
          },
          "faults": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/fault"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": [
        "ttp",
        "tactic",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "ttp": {
          "type": "string",
          "pattern": "^T\\d{4}(\\.\\d{3})?$"
        },
        "name": {
          "type": "string"
        },
        "tactic": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "planned"
          ]
        },
        "log_source": {
          "type": "string"
        },
        "indicator_key": {
          "type": "string"
        },
        "indicator_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_latency_s": {
          "type": "integer",
          "minimum": 0
        },
        "destructive": {
          "type": "boolean"
        },
        "requires_testdata": {
          "type": "boolean"
        },
        "safe_target": {
          "type": "string"
        },
        "testdata_marker": {
          "type": "string"
        },
        "reference_script": {
          "type": [
            "string",
            "null"
          ]
        },
        "setup_scripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engine": {
          "type": "string"
        },
        "engine_ref": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": true,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "default": {},
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        },
        "steady_state": {
          "description": "What 'normal' is on the target, verified before and after an engine-run technique (atomic, R1) — same shape as the experiment schema's steady_state. A probe and the value it must hold.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "probes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "verify"
                ],
                "additionalProperties": true,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "verify": {
                    "type": "string"
                  },
                  "expect": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "description": "An implemented technique on the local-script engine references a versioned script.",
          "if": {
            "allOf": [
              {
                "properties": {
                  "status": {
                    "const": "implemented"
                  }
                },
                "required": [
                  "status"
                ]
              },
              {
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "engine"
                      ]
                    }
                  },
                  {
                    "properties": {
                      "engine": {
                        "const": "local-script"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "then": {
            "required": [
              "reference_script",
              "destructive"
            ],
            "properties": {
              "reference_script": {
                "type": "string"
              }
            }
          }
        },
        {
          "description": "An implemented technique on another engine (Stratus, Atomic) is run by the engine's reference.",
          "if": {
            "allOf": [
              {
                "properties": {
                  "status": {
                    "const": "implemented"
                  }
                },
                "required": [
                  "status"
                ]
              },
              {
                "required": [
                  "engine"
                ],
                "properties": {
                  "engine": {
                    "not": {
                      "const": "local-script"
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "engine_ref",
              "destructive"
            ]
          }
        },
        {
          "description": "A destructive technique must declare its containment.",
          "if": {
            "properties": {
              "destructive": {
                "const": true
              }
            },
            "required": [
              "destructive"
            ]
          },
          "then": {
            "required": [
              "safe_target"
            ],
            "properties": {
              "safe_target": {
                "minLength": 1
              }
            }
          }
        },
        {
          "description": "An implemented atomic technique (engine: atomic, R1) verifies the initial state before and after: at least one steady-state probe, each with a non-empty verify and expect — like the experiment schema for an atomic.",
          "if": {
            "allOf": [
              {
                "properties": {
                  "status": {
                    "const": "implemented"
                  }
                },
                "required": [
                  "status"
                ]
              },
              {
                "properties": {
                  "engine": {
                    "const": "atomic"
                  }
                },
                "required": [
                  "engine"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "steady_state"
            ],
            "properties": {
              "steady_state": {
                "required": [
                  "probes"
                ],
                "properties": {
                  "probes": {
                    "minItems": 1,
                    "items": {
                      "required": [
                        "name",
                        "verify",
                        "expect"
                      ],
                      "properties": {
                        "verify": {
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "expect": {
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "fault": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "engine",
        "engine_ref",
        "destructive"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable fault id, e.g. vm-shutdown."
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "planned"
          ]
        },
        "engine": {
          "type": "string",
          "not": {
            "const": "local-script"
          }
        },
        "engine_ref": {
          "type": "string"
        },
        "destructive": {
          "type": "boolean",
          "description": "A fault is never run in production either way (inscription, O0)."
        },
        "log_source": {
          "type": "string",
          "description": "Where the fault becomes observable, if it does."
        },
        "expected_effect": {
          "type": "string"
        },
        "expected_latency_s": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
