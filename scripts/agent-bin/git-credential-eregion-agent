#!/bin/sh
# SEC12 (#418): git's credential helper for the agent sessions — the GitHub App's token for
# https://github.com/<this repository> only (scripts/agent_token.py). docs/sessions.md.
here=$(cd "$(dirname "$0")/.." && pwd)
py=${EREGION_AGENT_PYTHON:-$here/../.venv/bin/python}
[ -x "$py" ] || py=python3
exec "$py" "$here/agent_token.py" git-credential "$@"
