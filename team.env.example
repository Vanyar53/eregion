# Une équipe — profil « plusieurs équipes » (docs/profils/equipes.md).
# make team-init TEAM=<nom> copie ce fichier dans ~/.eregion/teams/<nom>/team.env, lisible par
# toi seul. docker compose le lit pour l'instance de cette équipe, et rien d'autre : ni ton
# .envrc, ni ton shell (make team-start le lance sous env -i). Chaque conteneur n'en reçoit que
# sa part (docker-compose.yml, M-3).
# Une ligne KEY=valeur. Pas de commentaire après une valeur : compose le prendrait pour elle.

# Le port de sa console, sur 127.0.0.1 — un par équipe (7007 : celui de make glorfindel-start).
EREGION_CONSOLE_PORT=7101
# Le jeton de sa console (openssl rand -hex 24) : obligatoire dès qu'elle sort de localhost.
EREGION_CONSOLE_TOKEN=

# Son abonnement et son espace Log Analytics, et le principal de service de SA watch. Reader
# et GLORFINDEL_READ_ONLY=1 : elle observe et propose, elle n'agit pas (le profil « découvrir »).
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_WORKSPACE_ID=
GLORFINDEL_READ_ONLY=1

# Le modèle qui décide (vide : le défaut, eregion_core/models.py) et sa clé.
GLORFINDEL_LLM_MODEL=
ANTHROPIC_API_KEY=

# Où vont ses escalades : son salon, son webhook — jamais ceux d'une autre équipe.
GLORFINDEL_WEBHOOK_URL=
DISCORD_CHANNEL_ID=
# Avec make team-start TEAM=<nom> BOT=1 : un bot par jeton, donc un jeton par équipe, et qui
# peut cliquer ses boutons (ids Discord ; vides, tous refusés).
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_ROLES=
